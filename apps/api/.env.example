# Selects the config/config.toml table: `local` or `deployed`.
STAGE=local

# Optional. Overrides the pino level (trace|debug|info|warn|error|fatal).
# LOG_LEVEL=debug

# Postgres connection string. Matches docker-compose.local.yml at the repo root.
DATABASE_URL=postgres://analog:analog@localhost:5433/analog

# Better Auth secret for encryption and hashing (min 32 chars).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Books API key for ISBN lookups. Create one at
# https://console.cloud.google.com/apis/credentials, restricted to the Books API.
GOOGLE_BOOKS_API_KEY=
