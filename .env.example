# Production env for docker-compose.yml. Copy to ~/analog/.env on the VPS.
STAGE=deployed

# Output of `scripts/create-db.sh analog` in vps-infra.
DATABASE_URL=

# Image tag to run. Written by vps-infra's deploy.sh on every deploy.
# Set to an older sha-<commit> and `docker compose up -d` to roll back.
IMAGE_TAG=

# Better Auth secret (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend API key for auth emails (OTP codes)
RESEND_API_KEY=
