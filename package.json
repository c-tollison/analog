{
    "name": "analog",
    "scripts": {
        "prepare": "husky",
        "biome:fix": "biome check --write --no-errors-on-unmatched",
        "prettier:fix": "prettier --write --log-level warn",
        "check": "pnpm biome:fix . && pnpm prettier:fix \"**/*.vue\"",
        "check:ci": "biome check . && prettier --check \"**/*.vue\"",
        "dev": "concurrently -n web -c green \"pnpm --filter @analog/web dev\"",
        "build": "pnpm -r --stream run build"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": "^24.12.0",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.3.4",
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "concurrently": "^10.0.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx,json,css}": [
            "pnpm biome:fix"
        ],
        "*.vue": [
            "pnpm biome:fix",
            "pnpm prettier:fix"
        ]
    }
}
