{
    "name": "analog",
    "scripts": {
        "prepare": "husky",
        "biome:fix": "biome check --write --no-errors-on-unmatched",
        "prettier:fix": "prettier --write --log-level warn",
        "check": "pnpm biome:fix . && pnpm prettier:fix \"**/*.vue\"",
        "check:ci": "biome check . && prettier --check \"**/*.vue\"",
        "dev": "pnpm local:start && concurrently -n api,web -c blue,green \"pnpm --filter @analog/api dev\" \"pnpm --filter @analog/web dev\"",
        "add-component": "node scripts/add-component.mjs",
        "build": "pnpm -r --stream run build",
        "local:start": "docker compose -f docker-compose.local.yml up -d --wait",
        "local:up": "pnpm local:start && pnpm db:migrate && pnpm db:seed",
        "local:down": "docker compose -f docker-compose.local.yml down",
        "local:reset": "docker compose -f docker-compose.local.yml down -v && pnpm local:up",
        "db:generate": "pnpm --filter @analog/db generate",
        "db:migrate": "pnpm --filter @analog/db migrate",
        "db:seed": "pnpm --filter @analog/db seed"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": "^24.12.0",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.3.4",
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "concurrently": "catalog:",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx,json,css}": [
            "pnpm biome:fix"
        ],
        "*.vue": [
            "pnpm biome:fix",
            "pnpm prettier:fix"
        ]
    }
}
